# Copie este arquivo para .env e defina uma senha forte para a sincronização administrativa.
ADMIN_USERNAME=admin
ADMIN_SYNC_PASSWORD=
BLACKCAT_API_KEY=
STORE_FRONTEND_ORIGINS=https://magazineskincare.online,https://magazineskincare.vercel.app
# Na Vercel, configure STORE_API_ORIGIN com a origem HTTPS do servidor PHP.
# STORE_ADMIN_URL é opcional e aponta para a URL HTTPS do admin.php.
# O painel PHP usa a mesma senha ADMIN_SYNC_PASSWORD, sem senha padrão pública.
# Se ficar vazia no computador local, o primeiro acesso permite criar uma senha.
# Em produção, configure uma senha forte no ambiente da hospedagem.


