Options -Indexes
RewriteEngine On
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(?:php|tests|scripts)/ - [F,L]
RewriteRule \.(?:py|zip|bat|ps1|sh|lock|json|ini|ya?ml|md)$ - [F,L,NC]
RewriteRule ^Dockerfile$ - [F,L]
RewriteRule ^admin\.html$ admin.php [R=302,L]
RewriteRule ^public/images/uploads/([a-f0-9]{32}\.(?:jpg|png|webp))$ api.php?route=/image/$1 [QSA,L]
RewriteRule ^api/(.*)$ api.php?route=/$1 [QSA,L]
RewriteRule ^((?:index|produto|carrinho|checkout|empresa)\.html)$ public-page.php?file=$1 [QSA,L]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(?:png|jpe?g|webp|gif|svg|ttf|otf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
